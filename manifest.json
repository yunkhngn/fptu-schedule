{
  "manifest_version": 3,
  "name": "FPTU Schedule",
  "description": "Modern Chrome extension for FPT University students to view and export schedules from FAP system to .ics calendar files.",
  "version": "4.1.0",
  "permissions": [
    "scripting",
    "tabs",
    "storage",
    "alarms",
    "notifications"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "*://fap.fpt.edu.vn/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://fap.fpt.edu.vn/*"
      ],
      "js": [
        "lib/fap-keepalive.js",
        "lib/fap-feedback.js",
        "lib/grades.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://fap.fpt.edu.vn/*"
      ],
      "css": [
        "lib/fap-ui-early.css"
      ],
      "js": [
        "lib/fap-routes.js",
        "lib/fap-ui-early.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://fap.fpt.edu.vn/*"
      ],
      "js": [
        "lib/fap-table-reader.js",
        "lib/fap-page-data.js",
        "lib/fap-readers-reports.js",
        "lib/fap-readers-conditions.js",
        "lib/fap-readers-academic.js",
        "lib/fap-readers-records.js",
        "lib/fap-readers-article.js",
        "lib/fap-readers-account.js",
        "dist/fap-ui.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dist/fonts/*"
      ],
      "matches": [
        "*://fap.fpt.edu.vn/*"
      ]
    }
  ]
}
